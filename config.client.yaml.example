# Left4Proxy 客户端配置文件示例 (config.client.yaml)

# 1. 外部服务器公网 IP / 域名列表 (支持多线路自动探测并选出最低延迟/最优路线)
# 客户端会对列表中所有 IP/域名同时发起连通性探测 (Ping/STUN/局域网广播)，并自动切换到最优线路
server_addrs:
  - "119.29.1.1:27014"        # 电信线路 IP
  - "182.92.2.2:27014"        # 联通/移动线路 IP
  - "l4d2.example.com:27014"  # 公网域名 / BGP 节点

# 也可使用单个主服务器 IP (若上面 server_addrs 为空，则回退使用此配置):
server_addr: "119.29.1.1:27014"

# 2. 本地监听地址 (专为求生之路 2 设计)
# 必须为 127.0.0.2:27015 (求生之路2拒绝连接 127.0.0.1)
listen_addr: "127.0.0.2:27015"

# 3. 路由模式:
# - "auto": 自动模式 (局域网直连 > 打洞直连 > 最优公网IP中继)
# - "direct-only": 仅使用打洞/局域网直连
# - "relay-only": 仅使用服务器中继
mode: "auto"

# 4. 优化开关
enable_lan: true      # 开启本地局域网广播检测 (同局域网内免走公网绕路)
enable_punch: true    # 开启 UDP STUN 尽力而为打洞
ping_interval: 3      # 线路延迟探测与打洞心跳间隔 (秒)
