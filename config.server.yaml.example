# Left4Proxy 服务端配置文件示例 (config.server.yaml)

# 1. 服务端监听地址 (默认监听所有网卡 0.0.0.0:27014)
listen_addr: ":27014"

# 2. 目标求生之路 2 专用服务器 (Upstream Target)
target_addr: "127.0.0.1:27015"

# 3. PROXY Protocol 支持 (v1/v2)
# 开启后，服务端解析来自前置代理 (frp/HAProxy) 的 PROXY Protocol 报文头，
# 从中提取客户端真实公网 IP:端口 (而非隧道出口地址)。需要在前置代理上启用对应功能。
proxy_protocol_v2: false

# 4. 服务器是否在 NAT 后 (无公网 IP 直连地址)
# "auto" (默认) 自动检测是否有公网接口 IP; 云 VPS 只有内网 VPC 地址时可显式设 true/false。
# 影响直连客户端被标记为 Direct (有公网 IP) 还是 Punch (NAT 后打洞/端口映射)。
nat: "auto"

# 5. 服务器声明的外部公网 IP / 域名列表 (供反射打洞与客户端分配使用)
public_ips:
  - "119.29.1.1"
  - "182.92.2.2"
  - "l4d2.example.com"

# 6. (预留) 打洞 / 穿透对等端口 —— 当前版本尚未使用
direct_port_range: "27015"
