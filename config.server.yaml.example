# Left4Proxy 服务端配置文件示例 (config.server.yaml)

# 首次加载此配置时，服务端会在同目录原子生成 0600 权限的 `.secret`。
# 通过可信渠道把同一个文件原样复制给所有客户端；不要写 `secret:` 字符串，
# 不要把 `.secret` 提交到 Git 或公开发送。

# 1. 服务端监听地址 (默认监听所有网卡 0.0.0.0:27014)
listen_addr: ":27014"

# 2. 目标求生之路 2 专用服务器 (Upstream Target)
target_addr: "127.0.0.1:27015"

# 3. 是否允许自动向本地路由器申请 UPnP 端口映射 (默认关闭；会改变路由器状态)
enable_upnp: false

# 4. 服务端可直连的 IP / 域名列表；可省略端口，自动使用监听端口。
# 这里只填写服务端自身的公网/LAN 地址。frp 等中继入口应填写在客户端 server_addrs。
public_ips:
  - "119.29.1.1"
  - "182.92.2.2"
  - "l4d2.example.com"

# 5. 公网 STUN 服务器 (用于打洞: 让 NAT 后的服务端反射出自己的公网端点)
# 需要可出站访问 UDP 3478。若服务端有端口映射/固定公网端口, 也可用 punch_addr 手动指定。
stun_server: "stun.cloudflare.com:3478"

# 6. (可选) 手动指定服务端公网打洞端点 (ip:port)。设置后跳过 UPnP 和 STUN 自动发现。
# 为空时自动用 stun_server 反射发现; 设置后跳过 STUN, 直接采用该值 (例如已有端口映射时)。
punch_addr: ""
